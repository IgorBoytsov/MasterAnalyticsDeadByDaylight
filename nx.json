{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "analytics": false,
    "plugins": [
        "@nx/dotnet",
        {
            "plugin": "@nx/playwright/plugin",
            "options": {
                "targetName": "e2e"
            }
        }
    ],
    "namedInputs": {
        "default": [
            "{projectRoot}/**/*"
        ],
        "production": [
            "default",
            "!{projectRoot}/**/*.Tests/**/*",
            "!{projectRoot}/**/bin/**/*",
            "!{projectRoot}/**/obj/**/*"
        ]
    },
    "targetDefaults": {
        "@angular/build:application": {
            "cache": true,
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "production",
                "^production"
            ]
        },
        "@angular/build:unit-test": {
            "cache": true,
            "inputs": [
                "default",
                "^production"
            ]
        }
    },
    "generators": {
        "@nx/angular:application": {
            "e2eTestRunner": "playwright",
            "style": "scss",
            "unitTestRunner": "vitest-angular"
        }
    }
}