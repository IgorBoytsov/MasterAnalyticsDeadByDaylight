{
    "name": "match",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "services/match/MatchTrace.Match.Api",
    "projectType": "application",
    "targets": {
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "command": "dotnet run",
                "cwd": "services/match/MatchTrace.Match.Api"
            },
            "configurations": {
                "watch": {
                    "command": "dotnet watch run",
                    "cwd": "services/match/MatchTrace.Match.Api"
                },
                "production": {
                    "command": "dotnet run --configuration Release",
                    "cwd": "services/match/MatchTrace.Match.Api"
                }
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "command": "dotnet build",
                "cwd": "services/match/MatchTrace.Match.Api"
            },
            "configurations": {
                "watch": {
                    "command": "dotnet watch build",
                    "cwd": "services/match/MatchTrace.Match.Api"
                },
                "production": {
                    "command": "dotnet build --configuration Release",
                    "cwd": "services/match/MatchTrace.Match.Api"
                }
            }
        }
    }
}