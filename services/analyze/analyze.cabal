cabal-version:      3.0
name:               analyze-service
version:            0.1.0.0
synopsis:           Match Trace Analytics Service
build-type:         Simple

executable analyze-service
    hs-source-dirs:      .
    main-is:             Main.hs
    build-depends:       base >= 4.17 && < 5,
                         servant >= 0.20 && < 0.21,
                         servant-server >= 0.20 && < 0.21,
                         warp >= 3.3 && < 3.5,
                         aeson >= 2.1 && < 2.3,
                         text >= 2.0 && < 2.2
    
    default-language:    Haskell2010
    ghc-options:         -Wall -O2